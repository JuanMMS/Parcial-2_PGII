<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="500.0" prefWidth="600.0" spacing="15" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.empresa.viewcontroller.GestionServiciosViewController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <HBox>
        <Button onAction="#volverMenuPrincipal" style="-fx-background-color: #bdc3c7; -fx-font-weight: bold;" text="← Volver al Menú Principal" />
    </HBox>
    <Separator />

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Gestión de Servicios Tecnológicos (Factory &amp; Decorator)" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-weight: bold;" text="Seleccionar Servicio Base:" />
        <ComboBox fx:id="cbServiciosBase" prefWidth="250" promptText="Elija un servicio..." />
    </HBox>

    <VBox spacing="10" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 12; -fx-background-color: #ffffff;">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Características Complementarias:" />
        <CheckBox fx:id="chkPrioritaria" text="Atención Prioritaria (+$35.000)" />
        <CheckBox fx:id="chkSoporte" text="Soporte Técnico 30 días (+$50.000)" />
        <CheckBox fx:id="chkDomicilio" text="Atención a Domicilio (+$25.000)" />
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="15" />

    <Label fx:id="lblCostoTotalServicio" style="-fx-font-size: 16px; -fx-text-fill: #27ae60; -fx-font-weight: bold;" text="Costo Total: $0.0" />
</VBox>
