<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.empresa.viewcontroller.GestionServiciosViewController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox>
        <Button text="← Volver al Menú Principal" onAction="#volverMenuPrincipal" style="-fx-background-color: #bdc3c7; -fx-font-weight: bold;"/>
    </HBox>
    <Separator/>

    <Label text="Gestión de Servicios Tecnológicos (Factory &amp; Decorator)" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Seleccionar Servicio Base:" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="cbServiciosBase" promptText="Elija un servicio..." prefWidth="250"/>
    </HBox>

    <VBox spacing="10" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 12; -fx-background-color: #ffffff;">
        <Label text="Características Complementarias:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
        <CheckBox fx:id="chkPrioritaria" text="Atención Prioritaria (+$35.000)"/>
        <CheckBox fx:id="chkSoporte" text="Soporte Técnico 30 días (+$50.000)"/>
        <CheckBox fx:id="chkDomicilio" text="Atención a Domicilio (+$25.000)"/>
    </VBox>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button text="Calcular Costo Final" onAction="#calcularCostoServicio" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
        <Button text="Crear Servicio Personalizado" onAction="#crearServicio" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
    </HBox>

    <Label fx:id="lblCostoTotalServicio" text="Costo Total: $0.0" style="-fx-font-size: 16px; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
</VBox>