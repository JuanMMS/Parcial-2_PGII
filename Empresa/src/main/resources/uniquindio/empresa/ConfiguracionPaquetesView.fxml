<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" prefHeight="520.0" prefWidth="620.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.empresa.viewcontroller.ConfiguracionPaquetesViewController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox>
        <Button text="← Volver al Menú Principal" onAction="#volverMenuPrincipal" style="-fx-background-color: #bdc3c7; -fx-font-weight: bold;"/>
    </HBox>
    <Separator/>

    <Label text="Configuración de Paquetes Tecnológicos (Composite)" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtCodigoPaquete" promptText="Código del Paquete" prefWidth="150"/>
        <TextField fx:id="txtNombrePaquete" promptText="Nombre del Paquete" prefWidth="220"/>
        <Button text="Crear Paquete" onAction="#crearPaquete" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Elementos Disponibles:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cbElementosDisponibles" promptText="Seleccione Elemento..." prefWidth="240"/>
            <Button text="Añadir al Paquete" onAction="#agregarElementoAPaquete" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
        </VBox>

        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Contenido del Paquete Actual:" style="-fx-font-weight: bold;"/>
            <ListView fx:id="lvContenidoPaquete" prefHeight="160"/>
        </VBox>
    </HBox>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button text="Calcular Costo del Paquete" onAction="#calcularCostoPaquete" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Label fx:id="lblCostoTotalPaquete" text="Total Paquete: $0.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
    </HBox>
</VBox>