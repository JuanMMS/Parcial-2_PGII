<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="550.0" prefWidth="700.0" spacing="15" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.empresa.viewcontroller.ConfiguracionPaquetesViewController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <HBox>
        <Button onAction="#volverMenuPrincipal" style="-fx-background-color: #bdc3c7; -fx-font-weight: bold;" text="← Volver al Menú Principal" />
    </HBox>
    <Separator />

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Configuración de Paquetes Tecnológicos (Composite)" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="txtCodigoPaquete" prefWidth="150" promptText="Código del Paquete" />
        <TextField fx:id="txtNombrePaquete" prefWidth="220" promptText="Nombre del Paquete" />
        <Button onAction="#crearPaquete" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Crear Paquete" />
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Sección Izquierda: Selección y Detalles -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="300">
            <Label style="-fx-font-weight: bold;" text="Elementos Disponibles:" />
            <ComboBox fx:id="cbElementosDisponibles" maxWidth="Infinity" promptText="Seleccione Elemento..." />

            <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: gray;" text="Contenido del elemento seleccionado:" />
            <ListView fx:id="lvDetalleSeleccionado" prefHeight="100" />

            <Button onAction="#agregarElementoAPaquete" style="-fx-background-color: #2980b9; -fx-text-fill: white;" text="Añadir al Nuevo Paquete ➔" maxWidth="Infinity"/>
        </VBox>

        <!-- Sección Derecha: Paquete en Construcción -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="300">
            <Label style="-fx-font-weight: bold;" text="Contenido del NUEVO Paquete:" />
            <ListView fx:id="lvContenidoPaquete" prefHeight="200" />
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label fx:id="lblCostoTotalPaquete" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Total Paquete: $0.0" />
    </HBox>
</VBox>